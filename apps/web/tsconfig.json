{
  // Docusaurus's own base config (paths for @site/*, @theme/*, the client
  // module aliases). The site's sources are JavaScript; the files that opt in
  // with `// @ts-check` (the config, the sidebars) are type-checked, and the
  // Worker is TypeScript.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["docusaurus.config.js", "sidebars.js", "site.js", "src", "worker"],
  "exclude": ["node_modules", "build", ".docusaurus", ".wrangler"]
}
